# Auto detect text files and perform LF normalization
* text=auto

# 脚本与源码统一 LF，避免 Windows 下 CRLF 破坏 shell/格式检查
*.sh text eol=lf
*.dart text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.lock text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.xcconfig text eol=lf
*.pbxproj text eol=lf
*.cmake text eol=lf
*.py text eol=lf

# 图片资源按二进制处理
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
